{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",        // ← change from "es2015"
    "moduleResolution": "NodeNext", // ← change from "bundler"
    "outDir": "./build",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}